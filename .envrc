# Per-project identity for edifact.
#
# Commits in this repository are authored by the shared srhostingDev account,
# not by the individual developer. direnv exports the identity for git so no
# per-clone `git config --local` is needed and nobody commits under the wrong
# name by accident.
#
# Requires direnv (`brew install direnv`) plus the shell hook, then run
# `direnv allow` once in this directory.

export GIT_AUTHOR_NAME="srhostingDev"
export GIT_AUTHOR_EMAIL="developer@srhosting.eu"
export GIT_COMMITTER_NAME="$GIT_AUTHOR_NAME"
export GIT_COMMITTER_EMAIL="$GIT_AUTHOR_EMAIL"

# Scope the GitHub CLI to the same account. The token is read from the gh
# keyring at shell time - never store it in this file.
#
# This fails closed in both directions: if gh has no token for srhostingDev, or
# if gh is not installed at all, a GH_TOKEN inherited from the surrounding shell
# is cleared instead of left standing. An env token outranks the gh keyring, so
# leaving one would let commands in this directory act as exactly the account
# this block exists to avoid.
if command -v gh >/dev/null 2>&1; then
  _gh_token="$(gh auth token --user srhostingDev 2>/dev/null)"
  if [ -n "$_gh_token" ]; then
    export GH_TOKEN="$_gh_token"
  else
    unset GH_TOKEN
    echo "direnv: no gh token for srhostingDev - run 'gh auth login --user srhostingDev'." >&2
    echo "direnv: GH_TOKEN cleared so gh falls back to its keyring instead of another account." >&2
  fi
  unset _gh_token
else
  unset GH_TOKEN
  echo "direnv: gh is not installed - run 'brew install gh'." >&2
  echo "direnv: GH_TOKEN cleared; without gh nothing here can pin the account." >&2
fi
