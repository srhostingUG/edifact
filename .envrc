# Per-project identity for edifact.
#
# Commits in this repository are authored by the shared srhostingDev account,
# not by the individual developer. direnv exports the identity for git so no
# per-clone `git config --local` is needed and nobody commits under the wrong
# name by accident.
#
# Requires direnv (`brew install direnv`) plus the shell hook, then run
# `direnv allow` once in this directory.

export GIT_AUTHOR_NAME="srhostingDev"
export GIT_AUTHOR_EMAIL="developer@srhosting.eu"
export GIT_COMMITTER_NAME="$GIT_AUTHOR_NAME"
export GIT_COMMITTER_EMAIL="$GIT_AUTHOR_EMAIL"

# Scope the GitHub CLI to the same account. The token is read from the gh
# keyring at shell time - never store it in this file.
#
# gh honours GH_TOKEN *and* GITHUB_TOKEN, both ahead of the keyring, so both
# have to go before the lookup: an inherited one would outrank exactly the
# account this block exists to pin.
unset GH_TOKEN GITHUB_TOKEN

if command -v gh >/dev/null 2>&1; then
  _gh_token="$(gh auth token --user srhostingDev 2>/dev/null)"

  if [ -n "$_gh_token" ]; then
    export GH_TOKEN="$_gh_token"
  else
    # Fail closed. Clearing the variables is not enough: gh would fall back to
    # whichever account is active in the keyring - possibly a personal one.
    # An unusable placeholder makes gh stop with "Bad credentials" instead of
    # acting under the wrong identity. The git variables above stay intact.
    export GH_TOKEN="no-srhostingdev-token-see-envrc"
    echo "direnv: no gh token for srhostingDev." >&2
    echo "direnv: run 'gh auth login' and complete the flow as srhostingDev," >&2
    echo "direnv: then 'gh auth switch --user srhostingDev'." >&2
    echo "direnv: until then gh fails here on purpose." >&2
  fi

  unset _gh_token
else
  export GH_TOKEN="gh-not-installed-see-envrc"
  echo "direnv: gh is not installed - run 'brew install gh'." >&2
  echo "direnv: gh fails here on purpose until then." >&2
fi
